package() {
  install -Dm644 "${srcdir}/contract.json" \
    "${pkgdir}/usr/share/gaiaos/security/gedefense-contract.json"
  install -Dm640 "${srcdir}/gaiaos-profile.toml" \
    "${pkgdir}/usr/share/gedefense/profiles/gaiaos.toml"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/gaiaos-gedefense-integration/README.md"
  install -Dm755 "${srcdir}/build-local-packages.sh" \
    "${pkgdir}/usr/lib/gaiaos/build-local-gedefense-packages"
  install -Dm755 "${srcdir}/verify_sync.py" \
    "${pkgdir}/usr/lib/gaiaos/verify-gedefense-sync"
  install -Dm755 "${srcdir}/gedefense-gaiaos-provision" \
    "${pkgdir}/usr/lib/gaiaos/gedefense-gaiaos-provision"
  install -Dm644 "${srcdir}/gedefense-gaiaos-provision.service" \
    "${pkgdir}/usr/lib/systemd/system/gedefense-gaiaos-provision.service"
  install -Dm644 "${srcdir}/gedefense-core-gaiaos.conf" \
    "${pkgdir}/usr/lib/systemd/system/gedefense-core.service.d/10-gaiaos-provision.conf"
  install -Dm755 "${srcdir}/gedefense-set-password" \
    "${pkgdir}/usr/lib/gaiaos/gedefense-set-password"
  install -Dm755 "${srcdir}/gedefense-app" \
    "${pkgdir}/usr/bin/gedefense-app"
  install -Dm644 "${srcdir}/gedefense.desktop" \
    "${pkgdir}/usr/share/applications/gedefense.desktop"
}
