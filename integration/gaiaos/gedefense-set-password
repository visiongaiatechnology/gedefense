#!/usr/bin/env bash
# STATUS: DIAMANT VGT SUPREME
set -Eeuo pipefail
umask 0077

readonly destination=/etc/vgt/gedefense/access-password
readonly state=/var/lib/vgt/gedefense
readonly binary=/opt/vgt/gedefense/current/bin/gedefense-access

[[ $(id -u) -eq 0 ]] || {
  printf 'root is required\n' >&2
  exit 1
}
[[ ! -L "$destination" && -x "$binary" ]] || {
  printf 'GeDefense password target is unavailable\n' >&2
  exit 1
}

temporary=$(mktemp -- "${destination}.new.XXXXXXXX")
trap 'rm -f -- "$temporary"' EXIT
"$binary" --hash-password-stdin >"$temporary"
chown gedefense:gedefense "$temporary"
chmod 0600 "$temporary"
mv -T -- "$temporary" "$destination"
rm -f -- "${state}/initial-access-password" /var/lib/vgt/gedefense-password-setup-required
systemctl try-restart gedefense-access.service
printf 'GeDefense operator password updated.\n'
