build() {
  # pkg-config values are supplied exclusively by signed Arch Qt packages.
  # shellcheck disable=SC2046
  g++ ${CXXFLAGS} ${CPPFLAGS} \
    -std=c++20 -fPIC -Wformat -Werror=format-security \
    $(pkg-config --cflags Qt6Widgets Qt6Network Qt6WebEngineWidgets) \
    "${srcdir}/gedefense-shell.cpp" \
    -o "${srcdir}/gedefense-shell" \
    ${LDFLAGS} -Wl,-z,relro,-z,now,-z,noexecstack -pie \
    $(pkg-config --libs Qt6Widgets Qt6Network Qt6WebEngineWidgets)
}

package() {
  install -Dm644 "${srcdir}/contract.json" \
    "${pkgdir}/usr/share/astraeaos/security/gedefense-contract.json"
  install -Dm640 "${srcdir}/astraeaos-profile.toml" \
    "${pkgdir}/usr/share/gedefense/profiles/astraeaos.toml"
  install -Dm644 "${srcdir}/README.md" \
    "${pkgdir}/usr/share/doc/astraeaos-gedefense-integration/README.md"
  install -Dm755 "${srcdir}/build-local-packages.sh" \
    "${pkgdir}/usr/lib/astraeaos/build-local-gedefense-packages"
  install -Dm755 "${srcdir}/verify_sync.py" \
    "${pkgdir}/usr/lib/astraeaos/verify-gedefense-sync"
  install -Dm755 "${srcdir}/gedefense-astraeaos-provision" \
    "${pkgdir}/usr/lib/astraeaos/gedefense-astraeaos-provision"
  install -Dm644 "${srcdir}/gedefense-astraeaos-provision.service" \
    "${pkgdir}/usr/lib/systemd/system/gedefense-astraeaos-provision.service"
  install -Dm644 "${srcdir}/gedefense-core-astraeaos.conf" \
    "${pkgdir}/usr/lib/systemd/system/gedefense-core.service.d/10-astraeaos-provision.conf"
  install -Dm755 "${srcdir}/gedefense-core-launch" \
    "${pkgdir}/usr/lib/astraeaos/gedefense-core-launch"
  install -Dm644 "${srcdir}/gedefense-control-astraeaos.conf" \
    "${pkgdir}/usr/lib/systemd/system/gedefense-control.service.d/10-astraeaos-provision.conf"
  install -Dm644 "${srcdir}/gedefense-access-astraeaos.conf" \
    "${pkgdir}/usr/lib/systemd/system/gedefense-access.service.d/10-astraeaos-loopback.conf"
  install -Dm755 "${srcdir}/gedefense-access-ready" \
    "${pkgdir}/usr/lib/astraeaos/gedefense-access-ready"
  install -Dm755 "${srcdir}/gedefense-ensure-ready" \
    "${pkgdir}/usr/lib/astraeaos/gedefense-ensure-ready"
  install -Dm755 "${srcdir}/gedefense-set-password" \
    "${pkgdir}/usr/lib/astraeaos/gedefense-set-password"
  install -Dm755 "${srcdir}/gedefense-app" \
    "${pkgdir}/usr/bin/gedefense-app"
  install -Dm755 "${srcdir}/gedefense-shell" \
    "${pkgdir}/usr/lib/astraeaos/gedefense-shell"
  install -Dm644 "${srcdir}/org.astraeaos.gedefense.policy" \
    "${pkgdir}/usr/share/polkit-1/actions/org.astraeaos.gedefense.policy"
  install -Dm644 "${srcdir}/50-astraeaos-gedefense.rules" \
    "${pkgdir}/usr/share/polkit-1/rules.d/50-astraeaos-gedefense.rules"
  install -Dm644 "${srcdir}/firefox-policies.json" \
    "${pkgdir}/etc/firefox/policies/policies.json"
  install -Dm755 "${srcdir}/astraeaos-boot-attestation" \
    "${pkgdir}/usr/lib/astraeaos/astraeaos-boot-attestation"
  install -Dm644 "${srcdir}/astraeaos-boot-attestation.service" \
    "${pkgdir}/usr/lib/systemd/system/astraeaos-boot-attestation.service"
  install -Dm644 "${srcdir}/astraeaos-runtime.conf" \
    "${pkgdir}/usr/lib/tmpfiles.d/astraeaos-runtime.conf"
  install -Dm755 "${srcdir}/astraeaos-security-login-gate" \
    "${pkgdir}/usr/lib/astraeaos/astraeaos-security-login-gate"
  install -Dm644 "${srcdir}/astraeaos-security-login-gate.service" \
    "${pkgdir}/usr/lib/systemd/system/astraeaos-security-login-gate.service"
  install -Dm755 "${srcdir}/astraeaos-security-boot-failure" \
    "${pkgdir}/usr/lib/astraeaos/astraeaos-security-boot-failure"
  install -Dm644 "${srcdir}/astraeaos-security-boot-failure.service" \
    "${pkgdir}/usr/lib/systemd/system/astraeaos-security-boot-failure.service"
