#!/usr/bin/env bash
# STATUS: DIAMANT VGT SUPREME
set -Eeuo pipefail
umask 0077

readonly CONFIG_DIR=/etc/vgt/gedefense
readonly SECRET_DIR=${CONFIG_DIR}/secrets
readonly STATE_DIR=/var/lib/vgt/gedefense
readonly RELEASE=/opt/vgt/gedefense/current
readonly PROFILE=/usr/share/gedefense/profiles/astraeaos.toml
readonly GENERIC_PROFILE=/usr/share/gedefense/profiles/generic.toml
readonly ACCESS_BINARY=/opt/vgt/gedefense/current/bin/gedefense-access

fail() {
  printf 'GeDefense AstraeaOS provisioning failed: %s\n' "$1" >&2
  exit 1
}

require_regular_or_absent() {
  local path=$1
  [[ ! -L "$path" ]] || fail "symlink refused: $path"
  [[ ! -e "$path" || -f "$path" ]] || fail "non-regular path refused: $path"
}

install_random_key() {
  local path=$1 owner=$2 group=$3 mode=$4
  require_regular_or_absent "$path"
  if [[ -f "$path" ]]; then
    [[ $(stat -c %s -- "$path") -eq 32 ]] || fail "invalid key length: $path"
  else
    local temporary
    temporary=$(mktemp -- "${path}.new.XXXXXXXX")
    head -c 32 /dev/urandom >"$temporary"
    chown "$owner:$group" "$temporary"
    chmod "$mode" "$temporary"
    mv -T -- "$temporary" "$path"
  fi
  chown "$owner:$group" "$path"
  chmod "$mode" "$path"
}

install_dashboard_token() {
  local path=${STATE_DIR}/dashboard.token
  require_regular_or_absent "$path"
  if [[ ! -s "$path" ]]; then
    local temporary
    temporary=$(mktemp -- "${path}.new.XXXXXXXX")
    openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n' >"$temporary"
    printf '\n' >>"$temporary"
    chown gedefense:gedefense "$temporary"
    chmod 0600 "$temporary"
    mv -T -- "$temporary" "$path"
  fi
}

install_initial_password() {
  local record=${CONFIG_DIR}/access-password
  require_regular_or_absent "$record"
  [[ -s "$record" ]] && return 0
  local plaintext record_tmp
  plaintext=$(openssl rand -base64 24 | tr -d '\n')
  record_tmp=$(mktemp -- "${record}.new.XXXXXXXX")
  printf '%s\n' "$plaintext" |
    "${RELEASE}/bin/gedefense-access" --hash-password-stdin >"$record_tmp"
  chown gedefense:gedefense "$record_tmp"
  chmod 0600 "$record_tmp"
  mv -T -- "$record_tmp" "$record"
  printf '%s\n' "$plaintext" >"${STATE_DIR}/initial-access-password"
  chown root:root "${STATE_DIR}/initial-access-password"
  chmod 0600 "${STATE_DIR}/initial-access-password"
  : >/var/lib/vgt/gedefense-password-setup-required
  chown root:root /var/lib/vgt/gedefense-password-setup-required
  chmod 0644 /var/lib/vgt/gedefense-password-setup-required
}

tls_identity_uses_p384() {
  local certificate=$1 details
  details=$(openssl x509 -in "$certificate" -noout -text 2>/dev/null) || return 1
  [[ "$details" == *'Public Key Algorithm: id-ecPublicKey'* ]] &&
    {
      [[ "$details" == *'ASN1 OID: secp384r1'* ]] ||
        [[ "$details" == *'NIST CURVE: P-384'* ]]
    }
}

install_tls_identity() {
  local cert=${CONFIG_DIR}/tls/access.crt key=${CONFIG_DIR}/tls/access.key
  require_regular_or_absent "$cert"
  require_regular_or_absent "$key"
  local rotate=false
  if [[ ! -s "$cert" || ! -s "$key" ]]; then
    rotate=true
  elif ! openssl x509 -in "$cert" -noout -checkend 86400 >/dev/null 2>&1; then
    rotate=true
  elif ! openssl x509 -in "$cert" -noout -checkip 127.0.0.1 >/dev/null 2>&1; then
    rotate=true
  elif ! openssl x509 -in "$cert" -noout -ext basicConstraints 2>/dev/null |
    grep -Fq 'CA:FALSE'; then
    rotate=true
  elif ! tls_identity_uses_p384 "$cert"; then
    rotate=true
  fi
  if [[ "$rotate" == true ]]; then
    rm -f -- "$cert" "$key"
    [[ -x "$ACCESS_BINARY" && ! -L "$ACCESS_BINARY" ]] ||
      fail 'GeDefense access binary is unavailable'
    "$ACCESS_BINARY" \
      --generate-self-signed \
      --public-host=127.0.0.1:9843 \
      --tls-cert="$cert" \
      --tls-key="$key"
  fi
  openssl verify \
    -CAfile "$cert" \
    -verify_ip 127.0.0.1 \
    -purpose sslserver \
    "$cert" >/dev/null || fail 'GeDefense loopback TLS identity validation failed'
  local constraints
  constraints=$(openssl x509 -in "$cert" -noout -ext basicConstraints) ||
    fail 'GeDefense loopback TLS constraints are unreadable'
  [[ "$constraints" == *'CA:FALSE'* ]] ||
    fail 'GeDefense loopback TLS certificate must not be a CA'
  chown root:gedefense "$cert"
  chown root:root "$key"
  chmod 0644 "$cert"
  chmod 0600 "$key"
}

install_xdr_baseline() {
  local destination=${CONFIG_DIR}/xdr-baseline.json
  local control_hash core_hash access_hash gedefense_uid temporary
  control_hash=$(sha256sum "${RELEASE}/bin/gedefense-control" | cut -d' ' -f1)
  core_hash=$(sha256sum "${RELEASE}/libexec/gedefense-core" | cut -d' ' -f1)
  access_hash=$(sha256sum "${RELEASE}/bin/gedefense-access" | cut -d' ' -f1)
  gedefense_uid=$(id -u gedefense)
  temporary=$(mktemp -- "${destination}.new.XXXXXXXX")
  printf '%s\n' \
    '{"version":1,"profiles":[{"executable":"/opt/vgt/gedefense/current/bin/gedefense-control","sha256":"'"$control_hash"'","allowed_uids":['"$gedefense_uid"'],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":true},{"executable":"/opt/vgt/gedefense/current/libexec/gedefense-core","sha256":"'"$core_hash"'","allowed_uids":[0],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":false},{"executable":"/opt/vgt/gedefense/current/bin/gedefense-access","sha256":"'"$access_hash"'","allowed_uids":['"$gedefense_uid"'],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":false}]}' \
    >"$temporary"
  chown root:gedefense "$temporary"
  chmod 0640 "$temporary"
  mv -T -- "$temporary" "$destination"
}

[[ $(id -u) -eq 0 ]] || fail "root is required"
[[ -x ${RELEASE}/bin/gedefense-access ]] || fail "GeDefense release is not installed"
[[ -f "$PROFILE" && ! -L "$PROFILE" ]] || fail "AstraeaOS profile is unavailable"

# The desktop launcher must traverse the exact public certificate path for
# TLS verification and SPKI pinning. 0751 permits traversal without directory
# listing; every private file remains protected by its own 0640/0600 mode.
install -d -m 0751 -o root -g gedefense "$CONFIG_DIR" "${CONFIG_DIR}/tls"
install -d -m 0750 -o root -g gedefense "$SECRET_DIR"
install -d -m 0755 -o root -g root /var/lib/vgt
install -d -m 1770 -o root -g gedefense "$STATE_DIR"
install -d -m 0700 -o root -g gedefense \
  "${STATE_DIR}/quarantine" "${STATE_DIR}/quarantine/objects"

require_regular_or_absent "${CONFIG_DIR}/gedefense.toml"
if [[ ! -f ${CONFIG_DIR}/gedefense.toml ]] ||
  {
    [[ -f "$GENERIC_PROFILE" && ! -L "$GENERIC_PROFILE" ]] &&
      cmp --silent -- "${CONFIG_DIR}/gedefense.toml" "$GENERIC_PROFILE"
  }; then
  install -m 0640 -o root -g gedefense "$PROFILE" "${CONFIG_DIR}/gedefense.toml"
fi

install_random_key "${SECRET_DIR}/core-ipc.key" root gedefense 0640
install_random_key "${SECRET_DIR}/storage-master.key" root gedefense 0640
install_random_key "${SECRET_DIR}/gaia-cells.key" root gedefense 0640
install_random_key "${STATE_DIR}/xdr-log.key" gedefense gedefense 0600
install_random_key "${STATE_DIR}/runtime-settings.key" gedefense gedefense 0600
install_random_key "${STATE_DIR}/access-session.key" gedefense gedefense 0600
install_dashboard_token
install_initial_password
install_tls_identity
install_xdr_baseline

printf 'GeDefense AstraeaOS provisioning complete.\n'
