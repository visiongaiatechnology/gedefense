#!/usr/bin/env bash
# STATUS: DIAMANT VGT SUPREME
set -Eeuo pipefail
umask 0077

readonly CONFIG_DIR=/etc/vgt/gedefense
readonly SECRET_DIR=${CONFIG_DIR}/secrets
readonly STATE_DIR=/var/lib/vgt/gedefense
# F-05 / CHAIN-005: the gateway-owned layout of the base unit is canonical. The
# AstraeaOS integration provisions exactly these paths instead of a separate
# /var/lib/vgt/gedefense layout that the base ExecStartPre steps cannot serve.
readonly ACCESS_CONFIG_DIR=/etc/vgt/gedefense-access
readonly ACCESS_STATE_PARENT=/var/lib/vgt/gedefense-access
readonly ACCESS_STATE_DIR=${ACCESS_STATE_PARENT}/state
readonly ACCESS_USER=gedefense-access
readonly ACCESS_GROUP=gedefense-access
readonly SCAN_RUN_DIR=/run/gedefense-scan
readonly RELEASE=/opt/vgt/gedefense/current
readonly PROFILE=/usr/share/gedefense/profiles/astraeaos.toml
readonly GENERIC_PROFILE=/usr/share/gedefense/profiles/generic.toml
readonly ACCESS_BINARY=/opt/vgt/gedefense/current/bin/gedefense-access
# POINT 2: privileged ephemeral parser-cell helper material. The helper unit is
# optional infrastructure (parser_cells.enabled=false by default); if it is not
# installed the key/dirs are still provisioned so a later package upgrade cannot
# start the helper against a half-provisioned trust root.
readonly CELL_HELPER_KEY=${SECRET_DIR}/cell-helper.key
readonly PARSER_INPUTS=${STATE_DIR}/parser-inputs
readonly PARSER_EXPORTS=${STATE_DIR}/parser-exports
readonly PARSER_IMPORTS=${STATE_DIR}/parser-imports
readonly PARSER_LEDGER=${STATE_DIR}/parser-burn-ledger.jsonl
readonly PARSER_PROFILE=${CONFIG_DIR}/parser-profiles.conf
readonly PARSER_PROFILE_TEMPLATE=/usr/share/gedefense/parser-profiles.conf

fail() {
  printf 'GeDefense AstraeaOS provisioning failed: %s\n' "$1" >&2
  exit 1
}

require_regular_or_absent() {
  local path=$1
  [[ ! -L "$path" ]] || fail "symlink refused: $path"
  [[ ! -e "$path" || -f "$path" ]] || fail "non-regular path refused: $path"
}

install_random_key() {
  local path=$1 owner=$2 group=$3 mode=$4
  require_regular_or_absent "$path"
  if [[ -f "$path" ]]; then
    [[ $(stat -c %s -- "$path") -eq 32 ]] || fail "invalid key length: $path"
  else
    local temporary
    temporary=$(mktemp -- "${path}.new.XXXXXXXX")
    head -c 32 /dev/urandom >"$temporary"
    chown "$owner:$group" "$temporary"
    chmod "$mode" "$temporary"
    mv -T -- "$temporary" "$path"
  fi
  chown "$owner:$group" "$path"
  chmod "$mode" "$path"
}

install_dashboard_token() {
  local path=${ACCESS_STATE_PARENT}/dashboard.token
  local legacy=${STATE_DIR}/dashboard.token
  if [[ ! -s $path && -s $legacy && ! -L $legacy ]]; then
    # Migrate the token from the pre-5.0 layout so control and gateway keep the
    # same credential instead of silently rotating it.
    mv -T -- "$legacy" "$path"
  fi
  require_regular_or_absent "$path"
  if [[ ! -s "$path" ]]; then
    local temporary
    temporary=$(mktemp -- "${path}.new.XXXXXXXX")
    openssl rand -base64 32 | tr '+/' '-_' | tr -d '=\n' >"$temporary"
    printf '\n' >>"$temporary"
    chown gedefense:"$ACCESS_GROUP" "$temporary"
    chmod 0600 "$temporary"
    mv -T -- "$temporary" "$path"
  fi
  chown gedefense:"$ACCESS_GROUP" "$path"
  chmod 0600 "$path"
  install_random_key "${ACCESS_STATE_PARENT}/dashboard.token.gateway-claim" gedefense "$ACCESS_GROUP" 0600
}

install_initial_password() {
  local record=${ACCESS_CONFIG_DIR}/access-password
  require_regular_or_absent "$record"
  [[ -s "$record" ]] && return 0
  local plaintext record_tmp secret_path secret_tmp marker_path marker_tmp
  plaintext=$(openssl rand -base64 24 | tr -d '\n')
  record_tmp=$(mktemp -- "${record}.new.XXXXXXXX")
  printf '%s\n' "$plaintext" |
    "${RELEASE}/bin/gedefense-access" --hash-password-stdin >"$record_tmp"
  chown "$ACCESS_USER:$ACCESS_GROUP" "$record_tmp"
  chmod 0600 "$record_tmp"
  mv -T -- "$record_tmp" "$record"

  secret_path=${STATE_DIR}/initial-access-password
  require_regular_or_absent "$secret_path"
  secret_tmp=$(mktemp -- "${secret_path}.new.XXXXXXXX")
  printf '%s\n' "$plaintext" >"$secret_tmp"
  chown root:root "$secret_tmp"
  chmod 0600 "$secret_tmp"
  mv -T -- "$secret_tmp" "$secret_path"

  marker_path=/var/lib/vgt/gedefense-password-setup-required
  require_regular_or_absent "$marker_path"
  marker_tmp=$(mktemp -- "${marker_path}.new.XXXXXXXX")
  chown root:root "$marker_tmp"
  chmod 0644 "$marker_tmp"
  mv -T -- "$marker_tmp" "$marker_path"
}

tls_identity_uses_p384() {
  local certificate=$1 details
  details=$(openssl x509 -in "$certificate" -noout -text 2>/dev/null) || return 1
  [[ "$details" == *'Public Key Algorithm: id-ecPublicKey'* ]] &&
    {
      [[ "$details" == *'ASN1 OID: secp384r1'* ]] ||
        [[ "$details" == *'NIST CURVE: P-384'* ]]
    }
}

install_tls_identity() {
  local cert=${CONFIG_DIR}/tls/access.crt key=${CONFIG_DIR}/tls/access.key
  require_regular_or_absent "$cert"
  require_regular_or_absent "$key"
  local rotate=false
  if [[ ! -s "$cert" || ! -s "$key" ]]; then
    rotate=true
  elif ! openssl x509 -in "$cert" -noout -checkend 86400 >/dev/null 2>&1; then
    rotate=true
  elif ! openssl x509 -in "$cert" -noout -checkip 127.0.0.1 >/dev/null 2>&1; then
    rotate=true
  elif ! openssl x509 -in "$cert" -noout -ext basicConstraints 2>/dev/null |
    grep -Fq 'CA:FALSE'; then
    rotate=true
  elif ! tls_identity_uses_p384 "$cert"; then
    rotate=true
  fi
  if [[ "$rotate" == true ]]; then
    rm -f -- "$cert" "$key"
    [[ -x "$ACCESS_BINARY" && ! -L "$ACCESS_BINARY" ]] ||
      fail 'GeDefense access binary is unavailable'
    "$ACCESS_BINARY" \
      --generate-self-signed \
      --public-host=127.0.0.1:9843 \
      --tls-cert="$cert" \
      --tls-key="$key"
  fi
  openssl verify \
    -CAfile "$cert" \
    -verify_ip 127.0.0.1 \
    -purpose sslserver \
    "$cert" >/dev/null || fail 'GeDefense loopback TLS identity validation failed'
  local constraints
  constraints=$(openssl x509 -in "$cert" -noout -ext basicConstraints) ||
    fail 'GeDefense loopback TLS constraints are unreadable'
  [[ "$constraints" == *'CA:FALSE'* ]] ||
    fail 'GeDefense loopback TLS certificate must not be a CA'
  chown root:gedefense "$cert"
  chown root:root "$key"
  chmod 0644 "$cert"
  chmod 0600 "$key"
  # The gateway-owned copy is what the unit passes to --tls-cert and what the
  # readiness helper uses; keep it in sync with the canonical identity.
  install -m 0644 -o "$ACCESS_USER" -g "$ACCESS_GROUP" "$cert" "${ACCESS_CONFIG_DIR}/access.crt"
}

install_xdr_baseline() {
  local destination=${CONFIG_DIR}/xdr-baseline.json
  local control_hash core_hash access_hash helper_hash gedefense_uid access_uid temporary
  control_hash=$(sha256sum "${RELEASE}/bin/gedefense-control" | cut -d' ' -f1)
  core_hash=$(sha256sum "${RELEASE}/libexec/gedefense-core" | cut -d' ' -f1)
  access_hash=$(sha256sum "${RELEASE}/bin/gedefense-access" | cut -d' ' -f1)
  helper_hash=""
  if [[ -f "${RELEASE}/libexec/gedefense-cell-helper" ]]; then
    helper_hash=$(sha256sum "${RELEASE}/libexec/gedefense-cell-helper" | cut -d' ' -f1)
  fi
  gedefense_uid=$(id -u gedefense)
  access_uid=$(id -u "${ACCESS_USER}" 2>/dev/null || printf '%s' "$gedefense_uid")
  temporary=$(mktemp -- "${destination}.new.XXXXXXXX")
  if [[ -n $helper_hash ]]; then
    printf '%s\n' \
      '{"version":1,"profiles":[{"executable":"/opt/vgt/gedefense/current/bin/gedefense-control","sha256":"'"$control_hash"'","allowed_uids":['"$gedefense_uid"'],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":true},{"executable":"/opt/vgt/gedefense/current/libexec/gedefense-core","sha256":"'"$core_hash"'","allowed_uids":[0],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":false},{"executable":"/opt/vgt/gedefense/current/libexec/gedefense-cell-helper","sha256":"'"$helper_hash"'","allowed_uids":[0],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":false},{"executable":"/opt/vgt/gedefense/current/bin/gedefense-access","sha256":"'"$access_hash"'","allowed_uids":['"$access_uid"'],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":false}]}' \
      >"$temporary"
  else
    printf '%s\n' \
      '{"version":1,"profiles":[{"executable":"/opt/vgt/gedefense/current/bin/gedefense-control","sha256":"'"$control_hash"'","allowed_uids":['"$gedefense_uid"'],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":true},{"executable":"/opt/vgt/gedefense/current/libexec/gedefense-core","sha256":"'"$core_hash"'","allowed_uids":[0],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":false},{"executable":"/opt/vgt/gedefense/current/bin/gedefense-access","sha256":"'"$access_uid"'","allowed_uids":['"$access_uid"'],"allowed_parents":["/usr/lib/systemd/systemd"],"allow_external_network":false}]}' \
      >"$temporary"
  fi
  chown root:gedefense "$temporary"
  chmod 0640 "$temporary"
  mv -T -- "$temporary" "$destination"
}

# POINT 2: keep the helper's staging material in the same provisioning contract
# as the generic package. The ledger must exist as a 0640 root:gedefense regular
# file (the helper unit's ReadWritePaths fails closed without it) and the profile
# default is header-only; an existing operator profile is never rewritten.
install_parser_cell_material() {
  local temporary
  require_regular_or_absent "$PARSER_LEDGER"
  if [[ ! -f $PARSER_LEDGER ]]; then
    temporary=$(mktemp -- "${PARSER_LEDGER}.new.XXXXXXXX")
    : >"$temporary"
    chown root:gedefense "$temporary"
    chmod 0640 "$temporary"
    mv -T -- "$temporary" "$PARSER_LEDGER"
  fi
  chown root:gedefense "$PARSER_LEDGER"
  chmod 0640 "$PARSER_LEDGER"
  [[ $(stat -c '%U:%G:%a' "$PARSER_LEDGER") == 'root:gedefense:640' ]] ||
    fail 'parser burn ledger permissions are inconsistent'

  require_regular_or_absent "$PARSER_PROFILE"
  if [[ ! -f $PARSER_PROFILE ]]; then
    if [[ -f $PARSER_PROFILE_TEMPLATE && ! -L $PARSER_PROFILE_TEMPLATE ]]; then
      install -m 0640 -o root -g root "$PARSER_PROFILE_TEMPLATE" "$PARSER_PROFILE"
    else
      temporary=$(mktemp -- "${PARSER_PROFILE}.new.XXXXXXXX")
      printf '%s\n' \
        '# /etc/vgt/gedefense/parser-profiles.conf' \
        '# POINT 2 parser-cell profiles: intentionally empty by default; see' \
        '# docs/POINT2-PARSER-CELLS.md §4 before adding a verified profile.' \
        >"$temporary"
      chown root:root "$temporary"
      chmod 0640 "$temporary"
      mv -T -- "$temporary" "$PARSER_PROFILE"
    fi
  fi
  chown root:root "$PARSER_PROFILE"
  chmod 0640 "$PARSER_PROFILE"
  [[ $(stat -c '%U:%G:%a' "$PARSER_PROFILE") == 'root:root:640' ]] ||
    fail 'parser profile permissions are inconsistent'
}

[[ $(id -u) -eq 0 ]] || fail "root is required"
[[ -x ${RELEASE}/bin/gedefense-access ]] || fail "GeDefense release is not installed"
[[ -f "$PROFILE" && ! -L "$PROFILE" ]] || fail "AstraeaOS profile is unavailable"

# The desktop launcher must traverse the exact public certificate path for
# TLS verification and SPKI pinning. 0751 permits traversal without directory
# listing; every private file remains protected by its own 0640/0600 mode.
install -d -m 0751 -o root -g gedefense "$CONFIG_DIR" "${CONFIG_DIR}/tls"
install -d -m 0750 -o root -g gedefense "$SECRET_DIR"
install -d -m 0755 -o root -g root /var/lib/vgt
install -d -m 1770 -o root -g gedefense "$STATE_DIR"
install -d -m 0700 -o root -g gedefense \
  "${STATE_DIR}/quarantine" "${STATE_DIR}/quarantine/objects"
# F-05: gateway runtime directories and the restricted user scan socket parent
# are part of the same provisioning contract as in the generic package.
install -d -m 0750 -o "$ACCESS_USER" -g "$ACCESS_GROUP" "$ACCESS_CONFIG_DIR"
install -d -m 0750 -o gedefense -g "$ACCESS_GROUP" "$ACCESS_STATE_PARENT"
install -d -m 0700 -o "$ACCESS_USER" -g "$ACCESS_GROUP" "$ACCESS_STATE_DIR"
install -d -m 0750 -o root -g gedefense "$SCAN_RUN_DIR"
# POINT 2: parser-cell staging roots. parser-inputs is control-owned
# (0730 gedefense:gedefense, helper staging-dir contract: Owner=Control-UID);
# parser-exports stays root:gedefense 0750 (only the helper writes there);
# parser-imports is the control-owned untrusted import copy (T5 fix).
install -d -m 0730 -o gedefense -g gedefense "$PARSER_INPUTS"
install -d -m 0750 -o root -g gedefense "$PARSER_EXPORTS"
install -d -m 0750 -o gedefense -g gedefense "$PARSER_IMPORTS"

require_regular_or_absent "${CONFIG_DIR}/gedefense.toml"
if [[ ! -f ${CONFIG_DIR}/gedefense.toml ]] ||
  {
    [[ -f "$GENERIC_PROFILE" && ! -L "$GENERIC_PROFILE" ]] &&
      cmp --silent -- "${CONFIG_DIR}/gedefense.toml" "$GENERIC_PROFILE"
  }; then
  install -m 0640 -o root -g gedefense "$PROFILE" "${CONFIG_DIR}/gedefense.toml"
fi

install_random_key "${SECRET_DIR}/core-ipc.key" root gedefense 0640
install_random_key "${SECRET_DIR}/storage-master.key" root gedefense 0640
install_random_key "${SECRET_DIR}/gaia-cells.key" root gedefense 0640
install_random_key "$CELL_HELPER_KEY" root gedefense 0640
install_random_key "${STATE_DIR}/xdr-log.key" gedefense gedefense 0600
install_random_key "${STATE_DIR}/runtime-settings.key" gedefense gedefense 0600
install_random_key "${ACCESS_STATE_DIR}/access-session.key" "$ACCESS_USER" "$ACCESS_GROUP" 0600
install_dashboard_token
install_initial_password
install_tls_identity
install_xdr_baseline
install_parser_cell_material

printf 'GeDefense AstraeaOS provisioning complete.\n'
