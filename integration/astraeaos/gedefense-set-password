#!/usr/bin/env bash
# STATUS: DIAMANT VGT SUPREME
# Usage:
#   gedefense-set-password --password-file /path/to/secret
#   printf '%s\n' "$password" | gedefense-set-password
#
# Prefer --password-file when launched via pkexec: piping through pkexec is
# unreliable (stdin often empty after the polkit dialog), which aborts in 1–2s.
set -Eeuo pipefail
umask 0077

readonly destination=/etc/vgt/gedefense/access-password
readonly state=/var/lib/vgt/gedefense
readonly binary=/opt/vgt/gedefense/current/bin/gedefense-access
readonly ensure_ready=/usr/lib/astraeaos/gedefense-ensure-ready

fail() {
  printf 'GeDefense set-password failed: %s\n' "$1" >&2
  exit 1
}

[[ $(id -u) -eq 0 ]] || fail "root is required"
[[ ! -L "$destination" && -x "$binary" ]] || fail "GeDefense password target is unavailable"

password_file=""
if [[ "${1:-}" == "--password-file" ]]; then
  password_file=${2:-}
  [[ -n "$password_file" ]] || fail "--password-file requires a path"
elif [[ -n "${1:-}" ]]; then
  password_file=$1
fi

temporary=$(mktemp -- "${destination}.new.XXXXXXXX")
rollback=""
cleanup() {
  if [[ -n "${temporary:-}" ]]; then
    rm -f -- "$temporary"
  fi
  if [[ -n "${password_file:-}" && -f "$password_file" ]]; then
    # Best-effort wipe of the caller-provided secret file.
    if command -v shred >/dev/null 2>&1; then
      shred -u -- "$password_file" 2>/dev/null || rm -f -- "$password_file"
    else
      rm -f -- "$password_file"
    fi
  fi
  if [[ -n "${rollback:-}" ]]; then
    rm -f -- "$rollback"
  fi
}
trap cleanup EXIT

if [[ -f "$destination" ]]; then
  rollback=$(mktemp -- "${destination}.rollback.XXXXXXXX")
  cp --preserve=mode,ownership -- "$destination" "$rollback"
fi

if [[ -n "$password_file" ]]; then
  [[ -f "$password_file" && ! -L "$password_file" ]] ||
    fail "password file is missing or not a regular file"
  # Root bypasses DAC; require a non-empty payload (12–1024 bytes like the UI).
  size=$(stat -c %s -- "$password_file" 2>/dev/null || echo 0)
  [[ "$size" -ge 12 && "$size" -le 1024 ]] ||
    fail "password file size out of bounds (${size} bytes)"
  "$binary" --hash-password-stdin <"$password_file" >"$temporary"
else
  # Direct stdin path (non-pkexec / tests).
  "$binary" --hash-password-stdin >"$temporary"
fi

chown gedefense:gedefense "$temporary"
chmod 0600 "$temporary"
mv -T -- "$temporary" "$destination"
# Prevent EXIT trap from removing the installed record after mv.
temporary=""

# Same privileged session: reload the credential and prove TLS readiness before
# committing the setup marker. Restore the previous record if activation fails.
if [[ -x "$ensure_ready" ]]; then
  if ! "$ensure_ready" --reload-access; then
    if [[ -n "$rollback" && -f "$rollback" ]]; then
      mv -T -- "$rollback" "$destination"
      rollback=""
      "$ensure_ready" --reload-access || true
    else
      rm -f -- "$destination"
    fi
    fail "new password activation failed; previous credential restored"
  fi
fi

if [[ -n "$rollback" ]]; then
  rm -f -- "$rollback"
fi
rollback=""
rm -f -- "${state}/initial-access-password" /var/lib/vgt/gedefense-password-setup-required
printf 'GeDefense operator password updated and gateway verified.\n'
