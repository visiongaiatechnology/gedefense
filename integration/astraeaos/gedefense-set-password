#!/usr/bin/env bash
# STATUS: DIAMANT VGT SUPREME
# Usage (privileged helper, F-14 / CHAIN-016):
#   printf '%s' "$password" | gedefense-set-password
#   gedefense-set-password --password-file /run/user/1000/gedefense-pw.XXXXXX
#
# The operator secret is accepted only through stdin or through a caller-owned
# regular file that is validated on an already-open file descriptor
# (mode 0600, fstat ownership == invoking user, no symlink swap). The helper
# never destructively erases a caller-supplied path: it only unlinks the file it validated
# itself when that file lives inside a caller-owned 0700 private directory;
# every other caller path is left untouched. Destructive validation is never
# performed before the validation passed.
set -Eeuo pipefail
umask 0077

readonly destination=/etc/vgt/gedefense-access/access-password
readonly state=/var/lib/vgt/gedefense
readonly binary=/opt/vgt/gedefense/current/bin/gedefense-access
readonly ensure_ready=/usr/lib/astraeaos/gedefense-ensure-ready
readonly access_user=gedefense-access
readonly access_group=gedefense-access

fail() {
  printf 'GeDefense set-password failed: %s\n' "$1" >&2
  exit 1
}

note() {
  printf 'GeDefense set-password: %s\n' "$1" >&2
}

[[ $(id -u) -eq 0 ]] || fail "root is required"
[[ ! -L "$destination" && -x "$binary" ]] || fail "GeDefense password target is unavailable"

# The invoking identity is supplied by the privilege boundary (pkexec or sudo).
caller_uid=""
if [[ ${PKEXEC_UID:-} =~ ^[0-9]+$ ]]; then
  caller_uid=$PKEXEC_UID
elif [[ ${SUDO_UID:-} =~ ^[0-9]+$ ]]; then
  caller_uid=$SUDO_UID
fi

password_file=""
if [[ $# -gt 0 ]]; then
  [[ $1 == --password-file && $# -eq 2 ]] ||
    fail "only an optional single --password-file argument is accepted"
  password_file=$2
  [[ -n $password_file ]] || fail "--password-file requires a path"
fi

staged_record=$(mktemp -- "${destination}.new.XXXXXXXX")
rollback=""
caller_path=""
caller_inode=""
caller_private_parent=0
cleanup() {
  rm -f -- "${staged_record:-}"
  if [[ -n ${rollback:-} ]]; then
    rm -f -- "$rollback"
  fi
  if [[ -n ${caller_path:-} && $caller_private_parent -eq 1 ]]; then
    # This is the validated caller-created private temp file the intended flow
    # (gedefense-app) hands over. The inode is re-checked so a race cannot
    # redirect the unlink to an unrelated file with the same name.
    if [[ -n ${caller_inode:-} ]] &&
      [[ $(stat -c '%d:%i' -- "$caller_path" 2>/dev/null || true) == "$caller_inode" ]]; then
      rm -f -- "$caller_path"
    fi
  fi
}
trap cleanup EXIT

# An existing password record is preserved as a rollback copy before the new
# record is activated.
if [[ -f $destination && ! -L $destination ]]; then
  rollback=$(mktemp -- "${destination}.rollback.XXXXXXXX")
  cp --preserve=mode,ownership -- "$destination" "$rollback"
fi

hash_from_stdin() {
  "$binary" --hash-password-stdin >"$staged_record"
}

if [[ -n $password_file ]]; then
  [[ -n $caller_uid ]] ||
    fail "--password-file requires an authenticated invoking user (PKEXEC_UID/SUDO_UID)"
  [[ ! -L $password_file ]] || fail "password file must not be a symlink"
  [[ -f $password_file ]] || fail "password file is missing or not a regular file"
  canonical=$(readlink -f -- "$password_file" 2>/dev/null) ||
    fail "password file path cannot be resolved"
  [[ -n $canonical && $canonical == /* ]] || fail "password file path is invalid"

  # Open once, then validate the descriptor itself (fstat) and confirm the
  # descriptor still names the canonical path. Reading the secret happens from
  # the same descriptor, so a symlink swap between check and read cannot work.
  exec 3<"$canonical" || fail "password file cannot be opened"
  descriptor_path=$(readlink /proc/self/fd/3 2>/dev/null || true)
  [[ $descriptor_path == "$canonical" ]] ||
    fail "password file changed while it was being validated"
  file_type=$(stat -L -c '%F' "/proc/self/fd/3") ||
    fail "password file could not be inspected"
  file_uid=$(stat -L -c '%u' "/proc/self/fd/3")
  file_mode=$(stat -L -c '%a' "/proc/self/fd/3")
  file_size=$(stat -L -c '%s' "/proc/self/fd/3")
  file_inode=$(stat -L -c '%d:%i' "/proc/self/fd/3")
  [[ $file_type == "regular file" ]] || fail "password file is not a regular file"
  [[ $file_mode == "600" ]] || fail "password file mode must be 0600 (got ${file_mode})"
  [[ $file_uid == "$caller_uid" ]] ||
    fail "password file must be owned by the invoking user (got uid ${file_uid})"
  [[ $file_size -ge 12 && $file_size -le 1024 ]] ||
    fail "password file size out of bounds (${file_size} bytes)"

  hash_from_stdin <&3
  exec 3<&-
  caller_path=$canonical
  caller_inode=$file_inode

  parent=$(dirname -- "$canonical")
  read -r parent_uid parent_mode < <(stat -c '%u %a' -- "$parent") ||
    fail "password file parent directory is unavailable"
  if [[ $parent_uid == "$caller_uid" && $parent_mode == "700" ]]; then
    caller_private_parent=1
  else
    note "caller-supplied password file is outside a private 0700 directory; the caller remains responsible for removing it"
    caller_private_parent=0
  fi
else
  # The live/unattended path: secret only on stdin, never in a file.
  hash_from_stdin
fi

if ! grep -Eq '^v2\$argon2id\$v=19\$m=[0-9]+,t=[0-9]+,p=[0-9]+\$[A-Za-z0-9+/]+\$[A-Za-z0-9+/]+$' -- "$staged_record"; then
  fail "password hashing did not produce a valid Argon2id record"
fi
install -d -m 0750 -o "$access_user" -g "$access_group" "$(dirname -- "$destination")"
chown "$access_user:$access_group" "$staged_record"
chmod 0600 "$staged_record"
mv -T -- "$staged_record" "$destination"
# The EXIT trap must not remove the installed record after the move.
staged_record=""

# Same privileged session: reload the credential and prove TLS readiness before
# committing the setup marker. Restore the previous record if activation fails.
if [[ -x $ensure_ready ]]; then
  if ! "$ensure_ready" --reload-access; then
    if [[ -n $rollback && -f $rollback ]]; then
      mv -T -- "$rollback" "$destination"
      rollback=""
      "$ensure_ready" --reload-access || true
    else
      rm -f -- "$destination"
    fi
    fail "new password activation failed; previous credential restored"
  fi
fi

if [[ -n $rollback ]]; then
  rm -f -- "$rollback"
fi
rollback=""
rm -f -- "${state}/initial-access-password" /var/lib/vgt/gedefense-password-setup-required
printf 'GeDefense operator password updated and gateway verified.\n'
