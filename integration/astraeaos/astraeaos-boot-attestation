# verify_fsverity_manifest verifies the operator-signed manifest and then measures
# every listed file with the real kernel FS_IOC_MEASURE_VERITY ioctl. No state JSON
# is trusted; the kernel measurement is the evidence.
verify_fsverity_manifest() {
  if [[ "$attestation_keys_ready" != true ]]; then
    degrade_fsverity "$attestation_keys_reason"
    return 1
  fi
  safe_regular "$fsverity_manifest" || { degrade_fsverity fsverity-manifest-unavailable; return 1; }
  safe_regular "$fsverity_manifest_signature" || { degrade_fsverity fsverity-manifest-signature-unavailable; return 1; }
  local manifest_sha256 signature_hex
  manifest_sha256="$(file_sha256 "$fsverity_manifest")"
  require_hex "$manifest_sha256" || { degrade_fsverity fsverity-manifest-invalid; return 1; }
  signature_hex="$(tr -d '[:space:]' < "$fsverity_manifest_signature")"
  if ! ed25519_verify_digest "$attestation_public_key" "$manifest_sha256" "$signature_hex"; then
    degrade_fsverity fsverity-manifest-signature-invalid
    return 1
  fi

  local measured
  if ! measured="$(python3 - "$fsverity_manifest" "$fsverity_manifest_schema" <<'PY'
# STATUS: DIAMANT VGT SUPREME
import errno
import fcntl
import hashlib
import json
import os
import stat
import struct
import sys

manifest_path, expected_schema = sys.argv[1], sys.argv[2]
MAX_BYTES = 1 << 20
MAX_FILES = 512
# _IOWR('f', 134, struct fsverity_digest): the flexible-array header is 4 bytes.
FS_IOC_MEASURE_VERITY = 0xC0048666
FS_VERITY_HASH_ALG_SHA256 = 1

try:
    with open(manifest_path, "rb") as handle:
        raw = handle.read(MAX_BYTES + 1)
    if len(raw) > MAX_BYTES:
        print("error=fsverity-manifest-too-large")
        raise SystemExit(1)
    value = json.loads(raw)
except (OSError, ValueError):
    print("error=fsverity-manifest-invalid")
    raise SystemExit(1)
if not isinstance(value, dict) or value.get("schema") != expected_schema:
    print("error=fsverity-manifest-invalid")
    raise SystemExit(1)
files = value.get("files")
if not isinstance(files, list) or not (1 <= len(files) <= MAX_FILES):
    print("error=fsverity-manifest-invalid")
    raise SystemExit(1)

def measure(path):
    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        if not stat.S_ISREG(os.fstat(descriptor).st_mode):
            raise OSError(errno.EINVAL, "not a regular file")
        buffer = bytearray(4 + 64)
        struct.pack_into("<HH", buffer, 0, FS_VERITY_HASH_ALG_SHA256, 64)
        fcntl.ioctl(descriptor, FS_IOC_MEASURE_VERITY, buffer, True)
        algorithm, size = struct.unpack_from("<HH", buffer, 0)
        if algorithm != FS_VERITY_HASH_ALG_SHA256 or size != 32:
            raise OSError(errno.EOPNOTSUPP, "unexpected fs-verity digest")
        return bytes(buffer[4:4 + size])
    finally:
        os.close(descriptor)

measurement_digest = hashlib.sha256()
for entry in files:
    if not isinstance(entry, dict) or set(entry) != {"path", "sha256"}:
        print("error=fsverity-manifest-invalid")
        raise SystemExit(1)
    path = entry["path"]
    expected = str(entry["sha256"]).lower()
    if (
        not isinstance(path, str)
        or not path.startswith("/")
        or len(path) > 4096
        or "\x00" in path
        or ".." in path.split("/")
        or os.path.normpath(path) != path
    ):
        print("error=fsverity-manifest-invalid")
        raise SystemExit(1)
    if len(expected) != 64 or any(character not in "0123456789abcdef" for character in expected):
        print("error=fsverity-manifest-invalid")
        raise SystemExit(1)
    try:
        measured = measure(path)
    except OSError as error:
        if error.errno in (errno.ENOTTY, errno.EOPNOTSUPP, errno.ENOSYS, errno.EINVAL):
            print("error=fsverity-unsupported")
        else:
            print("error=fsverity-measurement-unavailable")
        raise SystemExit(1)
    if measured.hex() != expected:
        print("error=fsverity-measurement-mismatch")
        raise SystemExit(1)
    measurement_digest.update(path.encode("utf-8"))
    measurement_digest.update(b"\x00")
    measurement_digest.update(measured)
    measurement_digest.update(b"\n")

print("files_measured=%d" % len(files))
print("measurement_digest=" + measurement_digest.hexdigest())
print("manifest_sha256=" + hashlib.sha256(raw).hexdigest())
PY
  )"; then
    local reason
    reason="$(sed -n 's/^error=//p' <<<"${measured:-error=fsverity-measurement-unavailable}" | head -n1)"
    degrade_fsverity "${reason:-fsverity-measurement-unavailable}"
    return 1
  fi

  local line measured_files=0 measurement_digest= reported_manifest_sha256=
  while IFS= read -r line; do
    case "$line" in
      files_measured=*) measured_files=${line#files_measured=} ;;
      measurement_digest=*) measurement_digest=${line#measurement_digest=} ;;
      manifest_sha256=*) reported_manifest_sha256=${line#manifest_sha256=} ;;
    esac
  done <<<"$measured"
  [[ "$measured_files" =~ ^[1-9][0-9]*$ && "$measured_files" -le 512 ]] || { degrade_fsverity fsverity-manifest-invalid; return 1; }
  require_hex "$measurement_digest" || { degrade_fsverity fsverity-manifest-invalid; return 1; }
  require_hex "$reported_manifest_sha256" || { degrade_fsverity fsverity-manifest-invalid; return 1; }
  [[ "$reported_manifest_sha256" == "$manifest_sha256" ]] || { degrade_fsverity fsverity-manifest-invalid; return 1; }

  fs_status=verified
  fs_reason=
  fs_method=FS_IOC_MEASURE_VERITY
  fs_manifest_sha256=$manifest_sha256
  fs_files_measured=$measured_files
  fs_measurement_digest=$measurement_digest
  fs_integrity_json="$(printf '{"status":"verified","method":"FS_IOC_MEASURE_VERITY","manifest_sha256":"%s","files_measured":%d,"measurement_digest":"%s"}' \
    "$fs_manifest_sha256" "$fs_files_measured" "$fs_measurement_digest")"
  return 0
}

# ------------------------------------------------------------- final verdict

if [[ "$boot_identity" == live ]]; then
  attestation_status=live-recovery
  hardware_attestation=unavailable
  attestation_reason=platform-attestation-unavailable
  pcr_policy_json=null
  fs_status=not-applicable
  fs_reason=
  fs_integrity_json='{"status":"not-applicable","method":"","manifest_sha256":"","files_measured":0,"measurement_digest":""}'
else
  verify_tpm_attestation || true
  verify_fsverity_manifest || true
  if [[ "$hardware_attestation" == verified && "$fs_status" == verified ]]; then
    attestation_status=verified
    attestation_reason=
  else
    attestation_status=degraded
    if [[ -z "$attestation_reason" ]]; then
      attestation_reason=$fs_reason
    fi
    if [[ -z "$attestation_reason" ]]; then
      attestation_reason=platform-attestation-degraded
    fi
  fi
fi

if [[ "$attestation_keys_ready" != true ]]; then
  # Without the pinned Ed25519 key pair the document can never be authenticated by
  # a consumer, so it must not claim any positive verdict.
  attestation_status=unavailable
  attestation_reason=$attestation_keys_reason
fi

# --------------------------------------------------- canonical signed document

document_tmp="$output_dir/.boot-attestation.$$.json"
signature_tmp="$output_dir/.boot-attestation.$$.sig"
trap 'rm -f -- "$document_tmp" "$signature_tmp"; cleanup' EXIT

canonical_digest="$(BOOT_ID="$boot_id" MODE="$mode" CMDLINE="$actual_cmdline" \
BOOT_IDENTITY="$boot_identity" SECURE_BOOT="$secure_boot" \
HARDWARE_ATTESTATION="$hardware_attestation" ATTESTATION_REASON="$attestation_reason" \
STATUS="$attestation_status" GENERATED_AT="$generated_at" NONCE="$nonce" BOOT_EPOCH="$boot_epoch" \
PCR_JSON="$pcr_policy_json" FS_JSON="$fs_integrity_json" \
python3 - "$document_tmp" <<'PY'
# STATUS: DIAMANT VGT SUPREME
import hashlib
import json
import os
import sys

pcr = None
if os.environ["PCR_JSON"] not in ("", "null"):
    pcr = json.loads(os.environ["PCR_JSON"])
value = {
    "schema": "astraeaos.boot-attestation.v2",
    "status": os.environ["STATUS"],
    "boot_identity": os.environ["BOOT_IDENTITY"],
    "boot_id": os.environ["BOOT_ID"],
    "generated_at": os.environ["GENERATED_AT"],
    "nonce": os.environ["NONCE"],
    "boot_epoch": int(os.environ["BOOT_EPOCH"]),
    "signing_mode": os.environ["MODE"],
    "secure_boot": os.environ["SECURE_BOOT"] == "true",
    "hardware_attestation": os.environ["HARDWARE_ATTESTATION"],
    "attestation_reason": os.environ["ATTESTATION_REASON"] or None,
    "kernel_command_line": os.environ["CMDLINE"],
    "pcr": pcr,
    "filesystem_integrity": json.loads(os.environ["FS_JSON"]),
}
canonical = json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8") + b"\n"
descriptor = os.open(sys.argv[1], os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC, 0o600)
try:
    os.write(descriptor, canonical)
    os.fsync(descriptor)
finally:
    os.close(descriptor)
print(hashlib.sha256(canonical).hexdigest())
PY
)"
require_hex "$canonical_digest" || die "attestation canonicalization failed"

signature_hex=
if [[ "$attestation_keys_ready" == true ]]; then
  if ! signature_hex="$(ed25519_sign_digest "$attestation_private_key" "$canonical_digest")"; then
    rm -f -- "$document_tmp"
    die "signing the boot attestation failed"
  fi
  if ! ed25519_verify_digest "$attestation_public_key" "$canonical_digest" "$signature_hex"; then
    rm -f -- "$document_tmp"
    die "self-verification of the boot attestation signature failed"
  fi
fi

chmod 0640 -- "$document_tmp"
chown root:gedefense -- "$document_tmp"
mv -T -- "$document_tmp" "$output_file"
if [[ -n "$signature_hex" ]]; then
  printf '%s\n' "$signature_hex" >"$signature_tmp"
  chmod 0640 -- "$signature_tmp"
  chown root:gedefense -- "$signature_tmp"
  mv -T -- "$signature_tmp" "$output_signature"
else
  rm -f -- "$output_signature"
fi

if [[ "$attestation_status" == verified || "$attestation_status" == live-recovery ]]; then
  printf 'AstraeaOS boot trust evidence recorded: %s.\n' "$attestation_status"
  exit 0
fi
printf 'AstraeaOS boot attestation degraded (fail-closed): %s\n' "$attestation_reason" >&2
exit 1
