if [[ "$secure_boot" == true && -n "$pcr_output" && -r "$pcr_signature" && ! -L "$pcr_signature" ]]; then
  pcr_signature_sha256="$(sha256sum "$pcr_signature" | awk '{print $1}')"
else
  if [[ "$boot_identity" == runtime-* ]]; then
    [[ "$secure_boot" == true ]] || die "UEFI Secure Boot is disabled or unavailable"
    [[ -r "$pcr_signature" && ! -L "$pcr_signature" ]] || die "UKI PCR signature is unavailable"
    [[ -c /dev/tpmrm0 || -c /dev/tpm0 ]] || die "TPM2 device is unavailable"
    [[ -n "$pcr_output" ]] || die "TPM2 PCR read failed"
    die "runtime platform attestation failed"
  fi
  attestation_status=live-recovery
  hardware_attestation=unavailable
  attestation_reason=platform-attestation-unavailable
fi

boot_id="$(cat /proc/sys/kernel/random/boot_id)"
mode="$(tr -d '\r\n' < "$signing_mode")"
pcr_public_sha256="$(openssl pkey -pubin -in "$pcr_public" -outform DER | sha256sum | awk '{print $1}')"

BOOT_ID="$boot_id" MODE="$mode" CMDLINE="$actual_cmdline" PCRS="$pcr_output" \
PCR_SIGNATURE_SHA256="$pcr_signature_sha256" PCR_PUBLIC_SHA256="$pcr_public_sha256" \
BOOT_IDENTITY="$boot_identity" FILESYSTEM_INTEGRITY_STATUS="$filesystem_integrity_status" \
FILESYSTEM_INTEGRITY_SHA256="$filesystem_integrity_sha256" STATUS="$attestation_status" \
HARDWARE_ATTESTATION="$hardware_attestation" ATTESTATION_REASON="$attestation_reason" \
SECURE_BOOT="$secure_boot" python3 - "$output_file" <<'PY'
