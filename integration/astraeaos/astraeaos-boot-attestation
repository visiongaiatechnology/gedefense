  )" || die "runtime fs-verity evidence is invalid"
  [[ "$filesystem_integrity_sha256" =~ ^[0-9a-f]{64}$ ]] || die "runtime fs-verity evidence hash is invalid"
  filesystem_integrity_status=verified
fi

secure_boot=false
if [[ -r "$efi_secure_boot" ]]; then
  secure_boot_byte="$(od -An -t u1 -j 4 -N 1 "$efi_secure_boot" | tr -d '[:space:]')"
  [[ "$secure_boot_byte" == 1 ]] && secure_boot=true
fi

attestation_status=verified
hardware_attestation=verified
attestation_reason=
pcr_output=
pcr_signature_sha256=
if [[ -r "$pcr_signature" && ! -L "$pcr_signature" && ( -c /dev/tpmrm0 || -c /dev/tpm0 ) ]] && command -v tpm2_pcrread >/dev/null 2>&1; then
  if ! pcr_output="$(tpm2_pcrread 'sha256:0,2,4,7,9,11,12' 2>&1)"; then
    pcr_output=
  fi
