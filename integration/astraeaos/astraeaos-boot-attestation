TOKEN_LIMIT = 256
TOKEN_BYTES_LIMIT = 1024
expected_tokens = sys.argv[1].split()
actual_tokens = sys.argv[2].split()
if (
    not expected_tokens
    or len(expected_tokens) > TOKEN_LIMIT
    or len(actual_tokens) > TOKEN_LIMIT
    or any(len(token.encode("utf-8")) > TOKEN_BYTES_LIMIT for token in actual_tokens)
):
    print("kernel-command-line-diff: token boundary rejected", file=sys.stderr)
    raise SystemExit(1)

