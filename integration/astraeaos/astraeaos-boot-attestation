actual_cmdline="$(tr -s '[:space:]' ' ' < /proc/cmdline | sed 's/^ //;s/ $//')"
astraeaos_mode=
astraeaos_slot=
for token in $actual_cmdline; do
  case "$token" in
    astraeaos.mode=*) astraeaos_mode=${token#astraeaos.mode=} ;;
    astraeaos.slot=*) astraeaos_slot=${token#astraeaos.slot=} ;;
