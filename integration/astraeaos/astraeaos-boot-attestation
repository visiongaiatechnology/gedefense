else
  [[ "$actual_cmdline" == "$policy_cmdline" ]] || die "runtime kernel command line differs from signed policy"
fi

filesystem_integrity_status=not-applicable
filesystem_integrity_sha256=
if [[ "$boot_identity" == runtime-* ]]; then
  readonly fsverity_evidence=/run/astraeaos/fsverity-state.json
  [[ -r "$fsverity_evidence" && ! -L "$fsverity_evidence" ]] || die "runtime fs-verity evidence is unavailable"
  filesystem_integrity_sha256="$(python3 - "$fsverity_evidence" <<'PY'
# STATUS: DIAMANT VGT SUPREME
import hashlib
import json
import pathlib
import sys

path = pathlib.Path(sys.argv[1])
