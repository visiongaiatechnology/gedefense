missing = expected - actual
extras = actual - expected

# SYSLINUX injects BOOT_IMAGE as either its selected label or the loaded kernel
# path. initrd is transport metadata as well. Neither value may alter the
# signed security policy, and every accepted representation is closed-set.
allowed_transport = (
    re.compile(r"initrd=/astraeaos/boot/x86_64/initramfs-linux-hardened[.]img"),
    re.compile(r"BOOT_IMAGE=/astraeaos/boot/x86_64/vmlinuz-linux-hardened"),
    re.compile(r"BOOT_IMAGE=astraeaos(?:verbose)?"),
)
invalid_extras = Counter()
for token, count in extras.items():
    if token in expected:
        continue
    if count != 1 or not any(pattern.fullmatch(token) for pattern in allowed_transport):
        invalid_extras[token] = count

