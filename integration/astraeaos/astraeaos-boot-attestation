    for token, count in sorted(values.items())[:12]:
        safe = re.sub(r"[^A-Za-z0-9_./,=:+-]", "?", token)[:160]
        rendered.append(f"{count}x:{safe}")
    return " ".join(rendered) if rendered else "none"

if missing or invalid_extras:
    print(f"kernel-command-line-diff missing=[{bounded(missing)}]", file=sys.stderr)
    print(f"kernel-command-line-diff unexpected=[{bounded(invalid_extras)}]", file=sys.stderr)
    raise SystemExit(1)
