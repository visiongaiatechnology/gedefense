value = {
    "schema": "astraeaos.boot-attestation.v1",
    "status": os.environ["STATUS"],
    "secure_boot": os.environ["SECURE_BOOT"] == "true",
    "hardware_attestation": os.environ["HARDWARE_ATTESTATION"],
    "attestation_reason": os.environ["ATTESTATION_REASON"] or None,
    "boot_id": os.environ["BOOT_ID"],
    "signing_mode": os.environ["MODE"],
    "kernel_command_line": os.environ["CMDLINE"],
    "pcr_signature_sha256": os.environ["PCR_SIGNATURE_SHA256"] or None,
    "pcr_public_key_sha256": os.environ["PCR_PUBLIC_SHA256"],
    "pcr_selection": [0, 2, 4, 7, 9, 11, 12] if hardware_verified else [],
    "pcr_readout": os.environ["PCRS"] if hardware_verified else "",
    "boot_identity": os.environ["BOOT_IDENTITY"],
    "filesystem_integrity": {
        "status": os.environ["FILESYSTEM_INTEGRITY_STATUS"],
        "evidence_sha256": os.environ["FILESYSTEM_INTEGRITY_SHA256"] or None,
    },
