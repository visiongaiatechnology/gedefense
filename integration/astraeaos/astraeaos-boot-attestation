set -Eeuo pipefail
umask 0077

readonly output_dir=/run/astraeaos
readonly output_file="$output_dir/boot-attestation.json"
readonly pcr_public=/usr/share/astraeaos/boot-trust/pcr-public.pem
readonly signing_mode=/usr/share/astraeaos/boot-trust/signing-mode
readonly pcr_signature=/run/systemd/tpm2-pcr-signature.json
readonly efi_secure_boot=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
readonly command_line_root=/usr/share/astraeaos/boot-trust

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing: $1"; }
need python3
need openssl
mkdir -p "$output_dir"
chown root:gedefense "$output_dir"
chmod 0750 "$output_dir"

[[ -r "$pcr_public" && ! -L "$pcr_public" ]] || die "PCR public key is unavailable"
[[ -r "$signing_mode" && ! -L "$signing_mode" ]] || die "Secure Boot signing mode is unavailable"

actual_cmdline="$(tr -s '[:space:]' ' ' < /proc/cmdline | sed 's/^ //;s/ $//')"
case " $actual_cmdline " in
  *' astraeaos.mode=live '*)
    boot_identity=live
    expected_cmdline="$command_line_root/kernel-command-line-live"
    ;;
  *' astraeaos.mode=runtime '*' astraeaos.slot=A '*)
    boot_identity=runtime-A
    expected_cmdline="$command_line_root/kernel-command-line-A"
    ;;
  *' astraeaos.mode=runtime '*' astraeaos.slot=B '*)
    boot_identity=runtime-B
    expected_cmdline="$command_line_root/kernel-command-line-B"
    ;;
  *) die "kernel command line has no valid AstraeaOS boot identity" ;;
esac
[[ -r "$expected_cmdline" && ! -L "$expected_cmdline" ]] || die "kernel command line policy is unavailable"
policy_cmdline="$(tr -s '[:space:]' ' ' < "$expected_cmdline" | sed 's/^ //;s/ $//')"
if [[ "$boot_identity" == live ]]; then
  python3 - "$policy_cmdline" "$actual_cmdline" <<'PY' || die "live kernel command line differs from signed policy"
# STATUS: DIAMANT VGT SUPREME
