else
  [[ "$actual_cmdline" == "$policy_cmdline" ]] || die "runtime kernel command line differs from signed policy"
fi

[[ -r "$signing_mode" && ! -L "$signing_mode" ]] || die "Secure Boot signing mode is unavailable"

# --------------------------------------------------------------- secure boot

secure_boot=false
if [[ -r "$efi_secure_boot" ]]; then
  secure_boot_byte="$(od -An -t u1 -j 4 -N 1 "$efi_secure_boot" | tr -d '[:space:]')"
  [[ "$secure_boot_byte" == 1 ]] && secure_boot=true
fi

# ---------------------------------------------------------- freshness material

boot_id="$(tr -d '[:space:]' < /proc/sys/kernel/random/boot_id)"
[[ "$boot_id" =~ ^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$ ]] || die "kernel boot id is invalid"
generated_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
nonce="$(python3 -c 'import os; print(os.urandom(32).hex())')"
[[ "$nonce" =~ ^[0-9a-f]{64}$ ]] || die "freshness nonce generation failed"
