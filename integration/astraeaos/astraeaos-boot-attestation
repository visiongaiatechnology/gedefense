[[ "$boot_epoch" =~ ^[0-9]+$ && "$boot_epoch" -gt 0 ]] || die "kernel boot epoch is unavailable"
mode="$(tr -d '\r\n' < "$signing_mode")"

# ------------------------------------------------------------ trust anchors

attestation_keys_ready=false
attestation_keys_reason=attestation-signing-unavailable
if safe_regular "$attestation_public_key" && safe_regular "$attestation_private_key"; then
  if is_ed25519_public_key "$attestation_public_key" && is_ed25519_private_key "$attestation_private_key"; then
    private_mode="$(stat -c '%a' -- "$attestation_private_key" 2>/dev/null || printf '')"
    if [[ "$private_mode" == 400 || "$private_mode" == 600 ]]; then
      private_der_sha="$(openssl pkey -in "$attestation_private_key" -pubout -outform DER 2>/dev/null | sha256sum | awk '{print $1}')"
      public_der_sha="$(openssl pkey -pubin -in "$attestation_public_key" -outform DER 2>/dev/null | sha256sum | awk '{print $1}')"
      if [[ -n "$private_der_sha" && "$private_der_sha" == "$public_der_sha" ]]; then
        attestation_keys_ready=true
      else
        attestation_keys_reason=attestation-keypair-mismatch
      fi
    else
      attestation_keys_reason=attestation-signing-key-permissions-invalid
    fi
  else
    attestation_keys_reason=attestation-signing-key-not-ed25519
  fi
fi

# --------------------------------------------------------- TPM2 PCR policy

hardware_attestation=unavailable
attestation_reason=platform-attestation-unavailable
pcr_policy_json=null

degrade_hardware() {
  hardware_attestation=degraded
  attestation_reason=$1
  pcr_policy_json=null
  return 1
}

# verify_tpm_attestation verifies the signed systemd-measure TPM2 PolicyPCR policy
# against the pinned key and against the live kernel TPM PCR values. It never
# claims success from the file format alone.
verify_tpm_attestation() {
  [[ "$secure_boot" == true ]] || { degrade_hardware secure-boot-disabled; return 1; }
  [[ -c /dev/tpmrm0 || -c /dev/tpm0 ]] || { degrade_hardware tpm-device-unavailable; return 1; }
  safe_regular "$tpm_pcr_signature" || { degrade_hardware tpm-pcr-policy-unavailable; return 1; }
  safe_regular "$tpm_public_key" || { degrade_hardware tpm-pcr-public-key-unavailable; return 1; }
  if ! openssl pkey -pubin -in "$tpm_public_key" -noout >/dev/null 2>&1; then
    degrade_hardware tpm-pcr-public-key-invalid
    return 1
  fi
  local pcr_public_sha256
  pcr_public_sha256="$(openssl pkey -pubin -in "$tpm_public_key" -outform DER | sha256sum | awk '{print $1}')"
  require_hex "$pcr_public_sha256" || { degrade_hardware tpm-pcr-public-key-invalid; return 1; }

  local parsed
  if ! parsed="$(python3 - "$tpm_pcr_signature" "$pcr_public_sha256" "$pcr_sysfs" "$pcr_selection_text" <<'PY'
# STATUS: DIAMANT VGT SUPREME
import base64
import hashlib
import json
import os
import shutil
import stat
import struct
import subprocess
import sys

json_path, public_key_sha256, pcr_sysfs, selection_text = sys.argv[1:5]
MAX_BYTES = 1 << 20
selection = [int(part) for part in selection_text.split(",")]

with open(json_path, "rb") as handle:
    raw = handle.read(MAX_BYTES + 1)
if len(raw) > MAX_BYTES:
    raise SystemExit("pcr-policy-too-large")
value = json.loads(raw)
if not isinstance(value, dict):
    raise SystemExit("pcr-policy-invalid")
bank = value.get("sha256")
if not isinstance(bank, list) or not bank:
    raise SystemExit("pcr-policy-invalid")

entries = []
for item in bank[:64]:
    if not isinstance(item, dict) or not {"pcrs", "pkfp", "pol", "sig"} <= set(item):
        raise SystemExit("pcr-policy-invalid")
    pol = str(item["pol"]).lower()
    pkfp = str(item["pkfp"]).lower()
    if len(pol) != 64 or any(character not in "0123456789abcdef" for character in pol):
        raise SystemExit("pcr-policy-invalid")
    if len(pkfp) != 64 or any(character not in "0123456789abcdef" for character in pkfp):
        raise SystemExit("pcr-policy-invalid")
    try:
        signature = base64.b64decode(str(item["sig"]), validate=True)
    except Exception:
        raise SystemExit("pcr-policy-invalid")
    if not (64 <= len(signature) <= 1024):
        raise SystemExit("pcr-policy-invalid")
    entries.append((pkfp, pol, base64.b64encode(signature).decode("ascii")))

def read_live_pcrs():
    if os.path.isdir(pcr_sysfs):
        values = {}
        for index in selection:
            path = os.path.join(pcr_sysfs, str(index))
            descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC)
            try:
                if not stat.S_ISREG(os.fstat(descriptor).st_mode):
                    raise SystemExit("pcr-readout-invalid")
                text = os.read(descriptor, 4096).decode("ascii", "strict").strip()
            finally:
                os.close(descriptor)
            if len(text) != 64 or any(character not in "0123456789abcdefABCDEF" for character in text):
                raise SystemExit("pcr-readout-invalid")
            values[index] = bytes.fromhex(text)
        return values, "sysfs"

    if shutil.which("tpm2_pcrread") is None:
        raise SystemExit("pcr-readout-unavailable")
    completed = subprocess.run(
        ["tpm2_pcrread", "sha256:" + ",".join(str(index) for index in selection)],
        capture_output=True,
        check=False,
        text=True,
        timeout=10,
    )
    if completed.returncode != 0:
        raise SystemExit("pcr-readout-unavailable")
    values = {}
    for line in completed.stdout.splitlines():
        line = line.strip()
        if ":" not in line:
            continue
        index_text, value_text = line.split(":", 1)
        try:
            index = int(index_text.strip())
        except ValueError:
            continue
        if index in selection:
            value_text = value_text.strip()
            if value_text.startswith("0x"):
                value_text = value_text[2:]
            if len(value_text) != 64:
                continue
            values[index] = bytes.fromhex(value_text)
    if len(values) != len(selection):
        raise SystemExit("pcr-readout-unavailable")
    return values, "tpm2_pcrread"

def policy_pcr_digest(values):
    pcr_digest = hashlib.sha256()
    mask = bytearray(3)
    last = -1
    for index in selection:
        if index <= last:
            raise SystemExit("pcr-selection-invalid")
        last = index
        pcr_digest.update(values[index])
        mask[index // 8] |= 1 << (index % 8)
    header = (
        struct.pack(">I", 0x0000017F)  # TPM_CC_PolicyPCR
        + struct.pack(">I", 1)         # TPML_PCR_SELECTION.count
        + struct.pack(">H", 0x000B)    # TPM2_ALG_SHA256
        + bytes([len(mask)])
        + bytes(mask)
    )
    extended = hashlib.sha256()
    extended.update(bytes(32))  # fresh policy session starts at an all-zero digest
    extended.update(header)
    extended.update(pcr_digest.digest())
    return extended.hexdigest()

live_values, source = read_live_pcrs()
computed = policy_pcr_digest(live_values)
if public_key_sha256.lower() not in {entry[0] for entry in entries}:
    raise SystemExit("pcr-policy-key-fingerprint-mismatch")
print("computed=" + computed)
print("values=" + json.dumps({str(index): live_values[index].hex() for index in selection},
                             sort_keys=True, separators=(",", ":")))
print("source=" + source)
print("entries=%d" % len(entries))
for index, (pkfp, pol, signature) in enumerate(entries):
    print("entry|%d|%s|%s|%s" % (index, pkfp, pol, signature))
PY
  )"; then
    degrade_hardware tpm-pcr-policy-invalid
    return 1
  fi

  local computed_policy= pcr_values_json= pcr_source= declared_entries=0 line
  local -a entry_lines=()
  while IFS= read -r line; do
    case "$line" in
      computed=*) computed_policy=${line#computed=} ;;
      values=*) pcr_values_json=${line#values=} ;;
      source=*) pcr_source=${line#source=} ;;
      entries=*) declared_entries=${line#entries=} ;;
      'entry|'*) entry_lines+=("$line") ;;
    esac
  done <<<"$parsed"
  require_hex "$computed_policy" || { degrade_hardware tpm-pcr-policy-invalid; return 1; }
  [[ -n "$pcr_values_json" && "$pcr_values_json" == \{* ]] || { degrade_hardware tpm-pcr-policy-invalid; return 1; }
  [[ "$pcr_source" == sysfs || "$pcr_source" == tpm2_pcrread ]] || { degrade_hardware tpm-pcr-policy-unavailable; return 1; }
  [[ "${#entry_lines[@]}" -gt 0 && "${#entry_lines[@]}" -eq "$declared_entries" ]] || {
    degrade_hardware tpm-pcr-policy-invalid
    return 1
  }

  local signature_file_sha256 matched=false tag index pkfp pol signature_b64
  signature_file_sha256="$(file_sha256 "$tpm_pcr_signature")"
  require_hex "$signature_file_sha256" || { degrade_hardware tpm-pcr-policy-invalid; return 1; }
  for line in "${entry_lines[@]}"; do
    IFS='|' read -r tag index pkfp pol signature_b64 <<<"$line"
    [[ "$tag" == entry ]] || continue
    [[ "$pol" == "$computed_policy" ]] || continue
    if [[ "$pkfp" != "$pcr_public_sha256" ]]; then
      degrade_hardware tpm-pcr-key-fingerprint-mismatch
      return 1
    fi
    hex_to_bin "$pol" "$tmp_dir/policy-digest.bin"
    if ! python3 -c 'import base64, sys; open(sys.argv[2], "wb").write(base64.b64decode(sys.argv[1], validate=True))' \
      "$signature_b64" "$tmp_dir/policy-signature.bin"; then
      degrade_hardware tpm-pcr-signature-invalid
      return 1
    fi
    # systemd-measure signs the PolicyPCR digest with the bank hash. RSA/ECDSA
    # keys verify with dgst -sha256 (PKCS#1 v1.5 / ECDSA over the digest); Ed25519
    # keys verify the raw digest message.
    if openssl dgst -sha256 -verify "$tpm_public_key" \
        -signature "$tmp_dir/policy-signature.bin" "$tmp_dir/policy-digest.bin" >/dev/null 2>&1 ||
      openssl pkeyutl -verify -pubin -inkey "$tpm_public_key" -rawin \
        -in "$tmp_dir/policy-digest.bin" -sigfile "$tmp_dir/policy-signature.bin" >/dev/null 2>&1; then
      matched=true
      break
    fi
  done
  rm -f -- "$tmp_dir/policy-digest.bin" "$tmp_dir/policy-signature.bin"
  if [[ "$matched" != true ]]; then
    degrade_hardware tpm-pcr-signature-invalid
    return 1
  fi

  local selection_json
  selection_json="$(python3 -c 'import json, sys; print(json.dumps([int(part) for part in sys.argv[1].split(",")]))' "$pcr_selection_text")"
  pcr_policy_json="$(printf '{"public_key_sha256":"%s","signature_sha256":"%s","selection":%s,"policy_digest":"%s","values":%s,"source":"%s"}' \
    "$pcr_public_sha256" "$signature_file_sha256" "$selection_json" "$computed_policy" "$pcr_values_json" "$pcr_source")"
  hardware_attestation=verified
  attestation_reason=
  return 0
}

