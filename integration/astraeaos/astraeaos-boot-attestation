#!/usr/bin/env bash
# STATUS: DIAMANT VGT SUPREME
#
# AstraeaOS local boot attestation, schema astraeaos.boot-attestation.v2.
#
# FIND-008 (CRITICAL, CHAIN-001): the previous revision hashed the systemd TPM PCR
# signature file and the fs-verity state JSON and then reported "verified". That
# was a format sham, not an attestation. This revision performs real cryptographic
# verification before it may ever publish status=verified:
#
#   1. TPM2 PCR policy: the systemd-measure JSON signature file
#      (/run/systemd/tpm2-pcr-signature.json, a signed TPM2 PolicyPCR policy) is
#      verified against the pinned PCR policy public key. The signed PolicyPCR
#      digest is recomputed from the live kernel TPM sysfs PCR values (fallback:
#      tpm2_pcrread) using the exact TPM/systemd algorithm; live values and the
#      signed digest must match. Missing TPM hardware or trust anchors degrade the
#      result, they never produce "verified".
#   2. fs-verity: every file of the operator-signed fs-verity manifest is measured
#      with the real kernel FS_IOC_MEASURE_VERITY ioctl and compared with the
#      manifest. Missing fs-verity support, a missing manifest or any mismatch
#      degrades the result; it never produces "verified".
#   3. The published attestation document is canonical JSON plus a detached
#      Ed25519 signature over its SHA-256 digest, made with the pinned signing key
#      and self-verified against the pinned public key before publication.
#
# Fail-closed policy: any missing tool, trust anchor, hardware capability or any
# mismatch yields DEGRADED/UNAVAILABLE, never "verified". No network access.
set -Eeuo pipefail
umask 0077

readonly output_dir=/run/astraeaos
readonly output_file="$output_dir/boot-attestation.json"
readonly output_signature="$output_dir/boot-attestation.sig"
readonly command_line_root=/usr/share/astraeaos/boot-trust
readonly signing_mode="$command_line_root/signing-mode"
readonly efi_secure_boot=/sys/firmware/efi/efivars/SecureBoot-8be4df61-93ca-11d2-aa0d-00e098032b8c
readonly tpm_public_key="$command_line_root/pcr-public.pem"
readonly tpm_pcr_signature=/run/systemd/tpm2-pcr-signature.json
readonly pcr_sysfs=/sys/class/tpm/tpm0/pcr-sha256
readonly attestation_public_key="$command_line_root/attestation-public.pem"
readonly attestation_private_key=/etc/astraeaos/boot-trust/attestation-signing.pem
readonly fsverity_manifest="$command_line_root/fsverity-manifest.json"
readonly fsverity_manifest_signature="$command_line_root/fsverity-manifest.json.sig"
readonly fsverity_manifest_schema=astraeaos.fsverity-manifest.v1
readonly -a pcr_selection=(0 2 4 7 9 11 12)
readonly pcr_selection_text=0,2,4,7,9,11,12

tmp_dir=
cleanup() {
  if [[ -n "$tmp_dir" && -d "$tmp_dir" ]]; then
    rm -rf -- "$tmp_dir"
  fi
}
trap cleanup EXIT

die() { printf 'ERROR: %s\n' "$*" >&2; exit 1; }
need() { command -v "$1" >/dev/null 2>&1 || die "missing required tool: $1"; }

safe_regular() {
  local path=$1
  [[ -f "$path" && ! -L "$path" ]]
}

require_hex() {
  [[ "$1" =~ ^[0-9a-f]{64}$ ]]
}

file_sha256() {
  sha256sum -- "$1" | awk '{print $1}'
}

hex_to_bin() {
  python3 -c 'import binascii, sys; open(sys.argv[2], "wb").write(binascii.unhexlify(sys.argv[1]))' "$1" "$2"
}

bin_to_hex() {
  python3 -c 'import binascii, sys; print(binascii.hexlify(open(sys.argv[1], "rb").read()).decode())' "$1"
}

is_ed25519_public_key() {
  openssl pkey -pubin -in "$1" -noout -text 2>/dev/null | grep -qi 'ED25519'
}

is_ed25519_private_key() {
  openssl pkey -in "$1" -noout -text 2>/dev/null | grep -qi 'ED25519'
}

# ed25519_verify_digest <public-key-pem> <sha256-digest-hex> <signature-hex>
ed25519_verify_digest() {
  local public_key=$1 digest_hex=$2 signature_hex=$3
  [[ "$digest_hex" =~ ^[0-9a-f]{64}$ ]] || return 1
  [[ "$signature_hex" =~ ^[0-9a-f]{128}$ ]] || return 1
  hex_to_bin "$digest_hex" "$tmp_dir/verify-digest.bin"
  hex_to_bin "$signature_hex" "$tmp_dir/verify-signature.bin"
  local result=1
  if openssl pkeyutl -verify -pubin -inkey "$public_key" -rawin \
    -in "$tmp_dir/verify-digest.bin" -sigfile "$tmp_dir/verify-signature.bin" >/dev/null 2>&1; then
    result=0
  fi
  rm -f -- "$tmp_dir/verify-digest.bin" "$tmp_dir/verify-signature.bin"
  return "$result"
}

# ed25519_sign_digest <private-key-pem> <sha256-digest-hex> -> prints signature hex
ed25519_sign_digest() {
  local private_key=$1 digest_hex=$2
  [[ "$digest_hex" =~ ^[0-9a-f]{64}$ ]] || return 1
  hex_to_bin "$digest_hex" "$tmp_dir/sign-digest.bin"
  if ! openssl pkeyutl -sign -inkey "$private_key" -rawin \
    -in "$tmp_dir/sign-digest.bin" -out "$tmp_dir/sign-signature.bin" >/dev/null 2>&1; then
    return 1
  fi
  local signature_hex
  signature_hex="$(bin_to_hex "$tmp_dir/sign-signature.bin")"
  [[ "$signature_hex" =~ ^[0-9a-f]{128}$ ]] || return 1
  printf '%s\n' "$signature_hex"
}

need python3
need openssl
tmp_dir="$(mktemp -d)"
mkdir -p "$output_dir"

