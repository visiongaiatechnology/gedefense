[Unit]
Description=VGT GeDefense Production Beta Rust XDP Core
After=gedefense-bpffs.service
Requires=gedefense-bpffs.service
Before=gedefense-control.service
StartLimitIntervalSec=120
StartLimitBurst=4

[Service]
Type=simple
User=root
Group=gedefense
RuntimeDirectory=vgt-gedefense
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
ExecStart=/opt/vgt/gedefense/current/libexec/gedefense-core --interface=auto --bpf-object=/opt/vgt/gedefense/current/lib/gedefense/gedefense-ebpf --socket=/run/vgt-gedefense/core.sock --scan-socket=/run/gedefense-scan/scan.sock --auth-key=/etc/vgt/gedefense/secrets/core-ipc.key --storage-key=/etc/vgt/gedefense/secrets/storage-master.key --quarantine-dir=/var/lib/vgt/gedefense/quarantine/objects --canary-root=/var/lib/vgt/gedefense/canaries --control-user=gedefense --malware-hashes=/etc/vgt/gedefense/malware-hashes.sha256
Restart=on-failure
RestartSec=3s
TimeoutStartSec=30s
TimeoutStopSec=15s
LimitMEMLOCK=infinity
NoNewPrivileges=true
CapabilityBoundingSet=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_KILL
AmbientCapabilities=CAP_BPF CAP_NET_ADMIN CAP_PERFMON CAP_SYS_ADMIN CAP_SYS_RESOURCE CAP_KILL
# M1.3 (6.2.0) tmp visibility decision:
# The core's fanotify sensors must see the *host* drop paths. `PrivateTmp=true`
# gives the service a private tmpfs at /tmp and /var/tmp, so every payload that
# the system, a web stack or an operator drops into the real /tmp, /var/tmp or
# /dev/shm was invisible to the on-access/on-write scanners (and the 6.1.2
# HardRed run showed exactly that blind spot). `PrivateTmp=false` therefore is a
# deliberate functional requirement, not an oversight: the core runs as root
# with CAP_BPF/CAP_SYS_ADMIN and could reach those paths anyway, and every
# quarantine operation stays fd-anchored (openat2/O_NOFOLLOW, no path-based
# writes). The remaining sandbox is unchanged and still strict:
# `ProtectSystem=strict` keeps the whole hierarchy read-only except the exact
# grants below, so /tmp, /var/tmp, /dev/shm and /var/www are writable only
# because the quarantine broker needs to move a detected payload out of them
# (a read-only mount would make FIND-035's copy fallback refuse the capture).
# /home and /opt stay read-only: their exec protection remains
# `FAN_OPEN_EXEC_PERM`, they are not on-write roots, and no secret/state path
# gains write access. CapabilityBoundingSet/AmbientCapabilities are unchanged.
PrivateTmp=false
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectClock=true
ProtectHostname=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service bpf perf_event_open pidfd_open pidfd_send_signal fanotify_init fanotify_mark
SystemCallErrorNumber=EPERM
ReadOnlyPaths=/opt/vgt/gedefense/current /etc/vgt/gedefense/secrets /etc/vgt/gedefense/malware-hashes.sha256 /home -/sys/kernel/tracing -/sys/kernel/debug/tracing
# V6.3.0 AP-3 (cross-view) and AP-5 (persistence/peripheral integrity) read the
# module list and the kernel taint flags to compare them against independent
# kernel views. ProtectSystem=strict/ProtectKernelTunables already keep these
# read-only; the explicit grants document the exact read-only surface and prevent
# a future, broader read from silently widening it. No write, no capability and
# no address-family is added by this line.
ReadOnlyPaths=-/sys/module -/proc/modules -/proc/sys/kernel/tainted
ReadWritePaths=/run/vgt-gedefense /run/gedefense-scan /sys/fs/bpf /var/lib/vgt/gedefense/quarantine /var/lib/vgt/gedefense/canaries
# M1.1/M1.3 (6.2.0): the four on-write drop roots. They are the exact default
# `--on-write-watch-root` set of the core; write access is required so the
# quarantine broker can rename the detected file out of the drop path. The
# leading "-" keeps hosts without /var/www (or a tmpfs /dev/shm) starting.
ReadWritePaths=-/tmp -/var/tmp -/dev/shm -/var/www
ReadWritePaths=/etc/sysctl.d
ReadWritePaths=-/proc/sys/kernel/kptr_restrict -/proc/sys/kernel/dmesg_restrict -/proc/sys/kernel/randomize_va_space -/proc/sys/kernel/yama/ptrace_scope -/proc/sys/kernel/unprivileged_bpf_disabled -/proc/sys/kernel/unprivileged_userns_clone
ReadWritePaths=-/proc/sys/fs/protected_fifos -/proc/sys/fs/protected_regular -/proc/sys/fs/suid_dumpable
ReadWritePaths=-/proc/sys/net/ipv4/tcp_syncookies -/proc/sys/net/ipv4/conf/all/accept_redirects -/proc/sys/net/ipv4/conf/default/accept_redirects -/proc/sys/net/ipv4/conf/all/send_redirects -/proc/sys/net/ipv4/conf/default/send_redirects
ReadWritePaths=-/proc/sys/net/ipv6/conf/all/accept_redirects -/proc/sys/net/ipv6/conf/default/accept_redirects
# M5.1 (6.2.0): additional CIS/Lynis controls need an exact write grant even
# though ProtectKernelTunables=true makes /proc/sys read-only by default. The
# leading "-" keeps hosts where a key is absent (e.g. old kernels) startable;
# the core's typed allowlist still rejects every value outside its domain.
ReadWritePaths=-/proc/sys/net/ipv4/conf/all/rp_filter -/proc/sys/net/ipv4/conf/default/rp_filter
ReadWritePaths=-/proc/sys/net/ipv4/conf/all/log_martians -/proc/sys/net/ipv4/conf/default/log_martians
ReadWritePaths=-/proc/sys/net/ipv4/icmp_echo_ignore_broadcasts -/proc/sys/net/ipv4/icmp_ignore_bogus_error_responses
ReadWritePaths=-/proc/sys/fs/protected_hardlinks -/proc/sys/fs/protected_symlinks
ReadWritePaths=-/proc/sys/kernel/perf_event_paranoid -/proc/sys/dev/tty/ldisc_autoload
ReadWritePaths=-/proc/sys/vm/swappiness
ReadWritePaths=-/proc/sys/net/ipv6/conf/all/disable_ipv6 -/proc/sys/net/ipv6/conf/default/disable_ipv6
# CVE-2026-98432 (net.mptcp.enabled) is mitigated by the core's allowlisted
# compare-set sysctl path; the mitigation guard reads and asserts it through the
# privileged core. ProtectKernelTunables=true keeps /proc/sys read-only, so this
# single node is granted explicitly instead of weakening the sandbox for all of
# /proc/sys. The "-" prefix keeps hosts without MPTCP support starting cleanly.
ReadWritePaths=-/proc/sys/net/mptcp/enabled
# POINT 5 (docs/POINT5-LOCKDOWN.md §8): deterministic, exact writable nodes for
# the Emergency Lockdown phases. ProtectKernelTunables=true makes /sys and
# /proc/sys read-only for the service, so the USB/Thunderbolt authorized /
# drivers_autoprobe policy (DMA/hotplug defense) and the reversible hardening
# sysctls need explicit single-node exceptions instead of widening the sandbox.
# Minimum privilege: no new capability, no AddressFamily, no SystemCallFilter
# change; modules_disabled is granted only for the explicit operator phase and
# is never written by the automatic trigger path.
# Risk note: /sys/bus/usb/devices and /sys/bus/thunderbolt/devices are sysfs
# symlinks into the device tree, so the kernel resolves every per-device
# "authorized" write to /sys/devices/**. A ReadWritePaths grant on the bus
# symlink alone would leave the resolved target read-only (EROFS) and the
# policy would fail safe but be ineffective. /sys/devices must therefore be
# writable as well. That is deliberately broader than the bus paths; the core
# only writes the allowlisted authorized/drivers_autoprobe attributes and no
# capability, address-family or syscall contract is widened.
ReadWritePaths=-/sys/bus/usb -/sys/bus/thunderbolt/devices -/sys/devices
ReadWritePaths=-/proc/sys/kernel/kexec_load_disabled -/proc/sys/kernel/sysrq -/proc/sys/kernel/modules_disabled
# V6.3.0 AP-4: opt-in io_uring/memfd hardening through the existing typed
# compare-set sysctl broker. `kernel.io_uring_disabled` is never set to 2 by the
# automatic path (that breaks databases/storage); the operator chooses 0/1/2.
# The leading "-" keeps hosts without these keys startable.
ReadWritePaths=-/proc/sys/kernel/io_uring_disabled -/proc/sys/vm/memfd_noexec
# The kernel lockdown latch (/var/lib/vgt/gedefense/LOCKDOWN.state) is persisted
# atomically: temporary file plus rename in the same 1770 root:gedefense directory
# provisioned by tmpfiles. Granting the directory (not a non-existent file) is the
# minimal write that also lets the core create the document on first trigger.
ReadWritePaths=/var/lib/vgt/gedefense
UMask=0077

[Install]
WantedBy=multi-user.target
